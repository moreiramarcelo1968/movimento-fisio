# Copie para .env.local e ajuste os valores.

AUTH_SECRET=
ADMIN_EMAIL=fisio@movimento.app
ADMIN_PASSWORD=movimento123
ADMIN_NAME=Marina Alves

# Vazio = PGlite local (arquivo .pglite).
# Em produção informe a connection string do Postgres.
# Neon: postgresql://...@ep-xxx.neon.tech/neondb?sslmode=require
# Prisma Postgres: postgres://...@db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL=

# Opcional. Endpoint com pool, usado pelo app em produção quando existir
# (o Prisma Postgres no Vercel injeta essa variável automaticamente).
DATABASE_URL_POOLED=
